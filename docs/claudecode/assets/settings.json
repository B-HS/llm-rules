{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "model": "fable",
    "effortLevel": "high",
    "permissions": {
        "allow": [
            "Bash(bun:*)",
            "Bash(bunx:*)",
            "Bash(bun run dev:*)",
            "Bash(bun run build:*)",
            "Bash(bun run typecheck:*)",
            "Bash(bun test:*)",
            "Bash(tsc:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(git push:*)"
        ],
        "ask": [
            "Bash(git merge:*)",
            "Bash(git rebase:*)",
            "Bash(npm install:*)",
            "Bash(npm i:*)",
            "Bash(pnpm add:*)",
            "Bash(yarn add:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./**/.env)",
            "Read(./**/.env.*)",
            "Read(./secrets/**)",
            "Edit(./.env)",
            "Edit(./.env.*)",
            "Edit(./secrets/**)",
            "Bash(rm -rf:*)",
            "Bash(git add .env:*)",
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git push --force-with-lease:*)",
            "Bash(git push --force-if-includes:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/llm-rules/scan-secrets.sh",
                        "timeout": 15
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/llm-rules/lint-edit.sh",
                        "timeout": 60
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/llm-rules/session-context.sh",
                        "timeout": 15
                    }
                ]
            }
        ]
    }
}
